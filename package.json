{
  "name": "cartofreq",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "electron-vite dev -- --no-sandbox",
    "dev:web": "vite",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "dist": "electron-vite build && electron-builder",
    "dist:linux": "electron-vite build && electron-builder --linux",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:win": "electron-vite build && electron-builder --win"
  },
  "dependencies": {
    "@julusian/midi": "^3.8.1",
    "@soundtouchjs/audio-worklet": "^2.1.1",
    "midi-writer-js": "^3.2.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@swc/core": "^1.13.5",
    "@types/three": "^0.187.0",
    "electron": "^45.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^6.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "dev.cartofreq",
    "productName": "Cartofreq",
    "executableName": "cartofreq",
    "artifactName": "cartofreq.${ext}",
    "icon": "build/icon.png",
    "extraResources": [{ "from": "build/icon.png", "to": "icon.png" }],
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "mac": {
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    },
    "afterPack": "scripts/linux-no-sandbox.cjs"
  }
}
